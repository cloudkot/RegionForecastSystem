<Window x:Class="RegionForecastSystem.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее место аналитика - РегионПрогноз" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#003366">
            <TextBlock Text="РАБОЧЕЕ МЕСТО АНАЛИТИКА | Ввод данных и отчетность" 
                       Foreground="White" FontSize="18" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="White" BorderBrush="#CCCCCC">

            <!-- Вкладка 1: Данные (как было) -->
            <TabItem Header="Управление данными" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Выберите таблицу:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbTables" Width="250" Height="30" SelectionChanged="CmbTables_SelectionChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="DataEditorGrid" Grid.Row="1" AutoGenerateColumns="True" 
                              CanUserAddRows="True" CanUserDeleteRows="True" IsReadOnly="False"
                              RowBackground="White" AlternatingRowBackground="#F9F9F9"/>

                    <Button x:Name="BtnSaveChanges" Grid.Row="2" Content="СОХРАНИТЬ ИЗМЕНЕНИЯ" 
                            HorizontalAlignment="Right" Width="200" Height="40" Margin="0,10,0,0"
                            Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                            Cursor="Hand" Click="BtnSaveChanges_Click"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Отчеты (как было) -->
            <TabItem Header="Аналитические отчеты" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Выберите отчет:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbReports" Width="350" Height="30"/>
                        <Button x:Name="BtnGenerateReport" Content="СФОРМИРОВАТЬ" Margin="10,0,0,0" 
                                Width="150" Height="30" Background="#003366" Foreground="White" 
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnGenerateReport_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="ReportGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                              RowBackground="White" AlternatingRowBackground="#F9F9F9"/>
                </Grid>
            </TabItem>

            <!-- НОВАЯ Вкладка 3: AI Анализ -->
            <TabItem Header="🤖 AI Прогнозирование" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть: Ввод данных -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Сводка по региону для анализа:" FontWeight="Bold" FontSize="16" Foreground="#333" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtAiInput" Height="250" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Padding="10" BorderBrush="#CCC"
                                 Text="Регион: Московская область.&#x0a;Население: 7 700 000 чел.&#x0a;ВРП за последние 3 года: 1.2, 1.3, 1.4 трлн руб.&#x0a;Безработица: 3.1%.&#x0a;Инвестиции: 500 млрд руб."/>

                        <Button x:Name="BtnRunAi" Content="🚀 ЗАПУСТИТЬ AI АНАЛИЗ" Margin="0,15,0,0" 
                                Height="45" Background="#8E44AD" Foreground="White" 
                                BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnRunAi_Click"/>

                        <ProgressBar x:Name="AiProgress" Height="5" Margin="0,10,0,0" IsIndeterminate="True" 
                                     Foreground="#8E44AD" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Правая часть: Вывод результата -->
                    <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AiResultPanel" Visibility="Collapsed">

                                <!-- Блок прогноза -->
                                <TextBlock Text="📊 ЭКОНОМИЧЕСКИЙ ПРОГНОЗ" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,5"/>
                                <TextBlock x:Name="TxtAiForecast" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20"/>

                                <!-- Блок рекомендаций -->
                                <TextBlock Text="✅ РЕКОМЕНДАЦИИ ПО РОСТУ ВРП" FontWeight="Bold" Foreground="#28A745" Margin="0,0,0,5"/>
                                <ItemsControl x:Name="ListRecommendations">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2" FontSize="13"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Height="1" Fill="#DDD" Margin="0,15,0,15"/>

                                <!-- Блок рисков -->
                                <TextBlock Text="⚠️ ПОТЕНЦИАЛЬНЫЕ РИСКИ" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,5"/>
                                <ItemsControl x:Name="ListRisks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2" FontSize="13"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
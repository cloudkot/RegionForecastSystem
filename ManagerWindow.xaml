<Window x:Class="RegionForecastSystem.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее место аналитика" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#003366">
            <Grid Margin="20,0">
                <TextBlock Text="РАБОЧЕЕ МЕСТО АНАЛИТИКА" Foreground="White" 
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="BtnLogout" Content="Выйти" HorizontalAlignment="Right" 
                        VerticalAlignment="Center" Width="100" Height="35" 
                        Background="#E74C3C" Foreground="White" BorderThickness="0" 
                        FontWeight="Bold" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="White" BorderBrush="#CCCCCC">

            <TabItem Header="Управление данными" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Таблица:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CmbTables" Width="250" Height="30" SelectionChanged="CmbTables_SelectionChanged"/>
                    </StackPanel>
                    <DataGrid x:Name="DataEditorGrid" Grid.Row="1" AutoGenerateColumns="True" 
                              CanUserAddRows="True" CanUserDeleteRows="True" RowBackground="White"/>
                    <Button x:Name="BtnSaveChanges" Grid.Row="2" Content="СОХРАНИТЬ" 
                            HorizontalAlignment="Right" Width="200" Height="40" Margin="0,10,0,0"
                            Background="#28A745" Foreground="White" FontWeight="Bold" Click="BtnSaveChanges_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Аналитические отчеты" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbReports" Width="350" Height="30"/>
                        <Button x:Name="BtnGenerateReport" Content="СФОРМИРОВАТЬ" Margin="10,0,0,0" 
                                Width="150" Height="30" Background="#003366" Foreground="White" Click="BtnGenerateReport_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ReportGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="AI Прогнозирование" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Сводка данных:" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtAiInput" Height="250" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Padding="10" BorderBrush="#CCC"/>
                        <Button x:Name="BtnRunAi" Content="ЗАПУСТИТЬ АНАЛИЗ" Margin="0,15,0,0" 
                                Height="45" Background="#003366" Foreground="White" FontWeight="Bold" Click="BtnRunAi_Click"/>
                        <ProgressBar x:Name="AiProgress" Height="5" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AiResultPanel" Visibility="Collapsed">

                                <TextBlock Text="ПРОГНОЗ ВРП" FontWeight="Bold" Foreground="#003366" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <TextBlock x:Name="TxtAiGrowth" FontSize="32" FontWeight="Bold" Foreground="#28A745" Text="+0.0%"/>
                                    <TextBlock x:Name="TxtAiAbsolute" FontSize="20" VerticalAlignment="Bottom" Margin="15,0,0,5" Foreground="#555"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtAiForecast" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20"/>

                                <TextBlock Text="РЕКОМЕНДАЦИИ" FontWeight="Bold" Foreground="#003366" Margin="0,0,0,5"/>
                                <ItemsControl x:Name="ListRecommendations">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Rectangle Height="1" Fill="#DDD" Margin="0,15,0,15"/>

                                <TextBlock Text="РИСКИ" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,5"/>
                                <ItemsControl x:Name="ListRisks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
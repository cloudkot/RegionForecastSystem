<Window x:Class="RegionForecastSystem.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель Администратора - РегионПрогноз" Height="750" Width="1100" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
        </Storyboard>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRoot" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#003366" Offset="0"/>
                    <GradientStop Color="#0055A5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,0">
                <TextBlock Text="ПАНЕЛЬ АДМИНИСТРАТОРА" Foreground="White" 
               FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenConstructor" Content="⚙ Конструктор БД" 
                Width="180" Height="40" Background="#FFFFFF" Foreground="#003366"
                FontWeight="Bold" BorderThickness="0" Click="BtnOpenConstructor_Click" Margin="0,0,10,0"/>

                    <Button x:Name="BtnLogout" Content="🚪 Выйти" 
                Width="100" Height="40" Background="#E74C3C" Foreground="White"
                FontWeight="Bold" BorderThickness="0" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,15,20,10">
            <Border Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,15,0" Width="200">
                <StackPanel>
                    <TextBlock Text="Всего пользователей" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalUsers" Text="0" FontSize="26" FontWeight="Bold" Foreground="#003366"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,15,0" Width="200">
                <StackPanel>
                    <TextBlock Text="Администраторов" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtAdminsCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="15,10" Width="200">
                <StackPanel>
                    <TextBlock Text="Менеджеров" Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="TxtManagersCount" Text="0" FontSize="26" FontWeight="Bold" Foreground="#28A745"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,5,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Пользователи системы" FontWeight="Bold" FontSize="16" 
                                   Foreground="#333" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBox x:Name="TxtSearch" Width="200" Height="30" Padding="5"
                                 TextChanged="TxtSearch_TextChanged" ToolTip="Поиск по логину"/>
                    </StackPanel>

                    <DataGrid x:Name="UsersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              CanUserAddRows="False" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                              SelectionMode="Single" BorderBrush="#DDD" SelectionChanged="UsersDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="BtnDeleteUser" Grid.Row="2" Content="Удалить выбранного пользователя" 
                            HorizontalAlignment="Left" Width="250" Height="35" Margin="0,10,0,0"
                            Background="#E74C3C" Foreground="White" BorderThickness="0" 
                            FontWeight="Bold" Click="BtnDeleteUser_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="Добавить пользователя" FontWeight="Bold" FontSize="16" 
                               Foreground="#333" Margin="0,0,0,15"/>

                    <TextBlock Text="Логин" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNewUsername" Height="35" Padding="8" BorderBrush="#DDD"/>

                    <TextBlock Text="Пароль" Foreground="#666" Margin="0,10,0,5"/>
                    <TextBox x:Name="TxtNewPassword" Height="35" Padding="8" BorderBrush="#DDD"/>

                    <TextBlock Text="Роль" Foreground="#666" Margin="0,10,0,5"/>
                    <ComboBox x:Name="CmbRole" Height="35" BorderBrush="#DDD">
                        <ComboBoxItem Content="User"/>
                        <ComboBoxItem Content="Manager"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>

                    <Button x:Name="BtnAddUser" Content="ДОБАВИТЬ" Margin="0,20,0,0" 
                            Height="40" Background="#28A745" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" Click="BtnAddUser_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
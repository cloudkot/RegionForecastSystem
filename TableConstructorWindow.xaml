<Window x:Class="RegionForecastSystem.TableConstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор БД" Height="500" Width="800" 
        WindowStartupLocation="CenterOwner" Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поле для имени таблицы -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Имя новой таблицы:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtTableName" Width="200" Height="30" Padding="5"/>
            <TextBlock Text="(английскими буквами, без пробелов)" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" FontSize="12"/>
        </StackPanel>

        <!-- Таблица с колонками -->
        <DataGrid x:Name="ColumnsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                  RowBackground="White" AlternatingRowBackground="#F9F9F9" BorderBrush="#CCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя колонки (Eng)" Binding="{Binding ColumnName}" Width="*"/>
                <DataGridComboBoxColumn Header="Тип данных" SelectedItemBinding="{Binding DataType}" Width="150">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>INT</sys:String>
                            <sys:String>NVARCHAR(100)</sys:String>
                            <sys:String>DECIMAL(18,2)</sys:String>
                            <sys:String>DATE</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridCheckBoxColumn Header="Primary Key" Binding="{Binding IsPrimaryKey}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка создания -->
        <Button Grid.Row="2" Content="🚀 Создать таблицу" HorizontalAlignment="Right" 
                Width="200" Height="40" Margin="0,15,0,0" Background="#28A745" 
                Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnCreateTable_Click"/>
    </Grid>
</Window>
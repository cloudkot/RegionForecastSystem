<Window x:Class="RegionForecastSystem.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр данных - РегионПрогноз" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#003366">
            <TextBlock Text="СИСТЕМА МОНИТОРИНГА | Режим просмотра" 
                       Foreground="White" FontSize="18" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Выберите раздел:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <ComboBox x:Name="CmbTables" Width="300" Height="30" SelectionChanged="CmbTables_SelectionChanged"/>
            </StackPanel>

            <DataGrid x:Name="ViewDataGrid" Grid.Row="1" AutoGenerateColumns="True" 
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      RowBackground="White" AlternatingRowBackground="#F9F9F9" BorderBrush="#CCCCCC"/>
        </Grid>
    </Grid>
</Window>